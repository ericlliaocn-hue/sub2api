# Copy this file to backend/.env.local and keep the local file uncommitted.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=change-me
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLE_TLS=false

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=change-me-at-least-8-characters

# Generate both values with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-value
TOTP_ENCRYPTION_KEY=change-me-to-a-random-64-character-hex-value
JWT_EXPIRE_HOUR=24

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=3000
TZ=Asia/Shanghai
